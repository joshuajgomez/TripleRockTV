<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wallpaper">

    <com.joshgm3z.triplerocktv.ui.search.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="50dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ll_container" />

    <LinearLayout
        android:id="@+id/ll_container"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceLow"
        android:gravity="center_horizontal|bottom"
        android:orientation="vertical"
        android:paddingHorizontal="30dp"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/logo_vd_vector" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in with your"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="?attr/colorForegroundMid"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IPTV login details"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="?attr/colorForegroundPrimary"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_server_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/edittext_background"
            android:drawableStart="@drawable/outline_link_2_24"
            android:drawablePadding="10sp"
            android:drawableTint="?attr/colorForegroundPrimary"
            android:hint="https://riseiptv.xyz:8080"
            android:textColor="?attr/colorForegroundHigh"
            android:textColorHint="?attr/colorForegroundLow"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/edittext_background"
            android:drawableStart="@drawable/outline_person_24"
            android:drawablePadding="10sp"
            android:drawableTint="?attr/colorForegroundPrimary"
            android:hint="Username"
            android:textColor="?attr/colorForegroundHigh"
            android:textColorHint="?attr/colorForegroundLow"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/edittext_background"
            android:drawableStart="@drawable/outline_password_24"
            android:drawablePadding="10sp"
            android:drawableTint="?attr/colorForegroundPrimary"
            android:hint="Password"
            android:textColor="?attr/colorForegroundHigh"
            android:textColorHint="?attr/colorForegroundLow"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.joshgm3z.triplerocktv.ui.common.ButtonView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:text="Login" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>