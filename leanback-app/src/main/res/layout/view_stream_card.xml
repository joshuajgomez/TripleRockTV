<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/poster_width"
    android:layout_height="@dimen/poster_height"
    android:layout_margin="2dp"
    android:background="@drawable/bg_rounded_card"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:foreground="@drawable/focusable_border_fg">

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_video_file" />

    <TextView
        android:id="@+id/stream_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="85dp"
        android:layout_marginEnd="10dp"
        android:maxLines="3"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/colorForegroundHigh"
        tools:text="Some movie with long name(2025) " />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/poster_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedPoster"
        tools:src="@drawable/avatar_movie" />

    <ImageView
        android:id="@+id/iv_go"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:src="@drawable/circle_go_icon"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="?attr/colorForegroundPrimary"
        android:paddingHorizontal="6dp"
        android:paddingBottom="1dp"
        android:text="New"
        android:textColor="?attr/colorBackground"
        android:textFontWeight="600"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>