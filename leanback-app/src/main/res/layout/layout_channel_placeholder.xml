<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="30dp">

    <com.joshgm3z.triplerocktv.ui.common.PlaceholderView
        android:id="@+id/ph_channel_name"
        android:layout_width="200dp"
        android:layout_height="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/ph_flow_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        app:constraint_referenced_ids="ph_time_frame1,ph_time_frame2,ph_time_frame3,ph_time_frame4"
        app:flow_horizontalGap="1dp"
        app:layout_constraintStart_toEndOf="@+id/ph_channel_name"
        app:layout_constraintTop_toTopOf="parent" />

    <com.joshgm3z.triplerocktv.ui.common.PlaceholderView
        android:id="@+id/ph_time_frame1"
        android:layout_width="100dp"
        android:layout_height="30dp" />

    <com.joshgm3z.triplerocktv.ui.common.PlaceholderView
        android:id="@+id/ph_time_frame2"
        android:layout_width="100dp"
        android:layout_height="30dp" />

    <com.joshgm3z.triplerocktv.ui.common.PlaceholderView
        android:id="@+id/ph_time_frame3"
        android:layout_width="100dp"
        android:layout_height="30dp" />

    <com.joshgm3z.triplerocktv.ui.common.PlaceholderView
        android:id="@+id/ph_time_frame4"
        android:layout_width="100dp"
        android:layout_height="30dp" />
</androidx.constraintlayout.widget.ConstraintLayout>