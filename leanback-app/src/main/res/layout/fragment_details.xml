<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:padding="20dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="650dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="visible"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toStartOf="@id/fl_sidebar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedRectangle"
        tools:src="@drawable/backdrop_office"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/fl_sidebar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/gradient_transparent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_backdrop"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorForegroundHigh"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            tools:text="@string/sample_movie_name" />

        <com.joshgm3z.triplerocktv.ui.common.MetadataView
            android:id="@+id/metadata_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp" />

        <com.joshgm3z.triplerocktv.ui.common.DelayedTextView
            android:id="@+id/tv_genre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:color="?attr/colorForegroundPrimary"
            tools:text="Comedy" />

        <com.joshgm3z.triplerocktv.ui.common.DelayedTextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="14"
            app:color="?attr/colorForegroundMid"
            app:placeholderHeight="100dp"
            tools:text="@string/sample_long_description" />

        <com.joshgm3z.triplerocktv.ui.common.DelayedTextView
            android:id="@+id/tv_cast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lines="2"
            app:color="?attr/colorForegroundLow"
            tools:text="Cast: John Gotti, John Gotti, John Gotti, John Gotti, " />

        <com.joshgm3z.triplerocktv.ui.common.DelayedTextView
            android:id="@+id/tv_director"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:color="?attr/colorForegroundLow"
            app:placeholderWidth="180dp"
            tools:text="Director: John Gotti, John Gotti, John Gotti, John Gotti, " />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_button_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/iv_backdrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_backdrop">

        <com.joshgm3z.triplerocktv.ui.common.TileButtonView
            android:id="@+id/bv_resume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawable="@drawable/baseline_play_arrow_14"
            android:text="Resume"
            android:visibility="gone"
            tools:visibility="gone" />

        <com.joshgm3z.triplerocktv.ui.common.TileButtonView
            android:id="@+id/bv_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawable="@drawable/baseline_play_arrow_14"
            android:text="Play"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.joshgm3z.triplerocktv.ui.common.TileButtonView
            android:id="@+id/bv_start_over"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:drawable="@drawable/baseline_replay_14"
            android:text="Start over"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.joshgm3z.triplerocktv.ui.common.TileButtonView
            android:id="@+id/bv_more_episodes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:drawable="@drawable/outline_video_template_14"
            android:text="More episodes"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.joshgm3z.triplerocktv.ui.common.TileButtonView
            android:id="@+id/bv_add_my_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:drawable="@drawable/baseline_playlist_add_14"
            android:text="Add to favorites"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.joshgm3z.triplerocktv.ui.common.TileButtonView
            android:id="@+id/bv_remove_my_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:drawable="@drawable/baseline_playlist_add_check_14"
            android:text="Remove from favorites"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
