<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:padding="20dp">

    <FrameLayout
        android:id="@+id/fl_programs_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/video_support_fragment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/video_support_fragment"
        android:name="androidx.leanback.app.VideoSupportFragment"
        android:layout_width="570dp"
        android:layout_height="310dp"
        android:descendantFocusability="blocksDescendants"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ll_error_container"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceLow"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/video_support_fragment"
        app:layout_constraintEnd_toEndOf="@+id/video_support_fragment"
        app:layout_constraintStart_toStartOf="@+id/video_support_fragment"
        app:layout_constraintTop_toTopOf="@id/video_support_fragment">

        <TextView
            android:id="@+id/tv_playback_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textColor="?attr/colorForegroundMid"
            android:textFontWeight="500"
            android:textSize="@dimen/text_size_small"
            tools:text="Video not supported on this device" />

        <TextView
            android:id="@+id/tv_playback_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textColor="?attr/colorForegroundLow"
            android:textSize="@dimen/text_size_small"
            tools:text="Error code 3000" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_programs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:descendantFocusability="blocksDescendants"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/video_support_fragment"
        app:layout_constraintTop_toBottomOf="@id/video_support_fragment"
        tools:listitem="@layout/item_program" />

    <TextView
        android:id="@+id/tv_no_program"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/program_background"
        android:gravity="center"
        android:text="No program info"
        android:textColor="?attr/colorForegroundLow"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/video_support_fragment"
        app:layout_constraintTop_toBottomOf="@id/video_support_fragment" />

</androidx.constraintlayout.widget.ConstraintLayout>